---
import Week from './Week.astro';
import Icon from './Icon.astro';
import { info, footerTreatments } from '../data/site';
---
<footer class="ft">
  <div class="wrap ft-top">
    <div>
      <p class="h2">Gun je huid de aandacht die ze verdient.</p>
      <div class="actions">
        <a class="btn btn--sunset" href={info.booking} target="_blank" rel="noopener">Afspraak maken<Icon name="arrow-up-right" /></a>
      </div>
      <p style="margin-top:28px;max-width:44ch">Tijdens behandelingen wordt de telefoon niet beantwoord, ik contacteer je zo vlug mogelijk.</p>
    </div>
    <div>
      <h4>Openingsuren</h4>
      <Week />
    </div>
    <div>
      <h4>Behandelingen</h4>
      <ul role="list">{footerTreatments.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Contact</h4>
      <p>{info.street}<br />{info.city}</p>
      <p style="margin-top:12px"><a href={info.phoneHref}>{info.phone}</a><br /><a href={`mailto:${info.email}`}>{info.email}</a></p>
      <p style="margin-top:12px"><a href={info.webshop} target="_blank" rel="noopener">Webshop: producten en cadeaubonnen</a><br /><a href={info.instagram} target="_blank" rel="noopener">Instagram</a><br /><a href={info.facebook} target="_blank" rel="noopener">Facebook</a></p>
    </div>
  </div>
  <div class="wrap ft-base">
    <span>© {new Date().getFullYear()} Instituut Soleil, btw {info.vat}</span>
    <span><a href="/journaal/">Journaal</a>, <a href="https://instituutsoleil.be/privacy-policy/">Privacybeleid</a></span>
  </div>
</footer>
