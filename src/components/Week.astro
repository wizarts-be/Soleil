---
import { hours, hoursNote, time } from '../data/site';
---
<div class="week" data-week>
  {hours.map((h) => (
    <div class:list={{ closed: !h.open }} data-day={h.d}>
      <b>{h.day}</b>
      <span>{h.open ? `${time(h.open)} - ${time(h.close)}` : 'gesloten'}{h.note && <>, {h.note}</>}</span>
    </div>
  ))}
  <p class="week-note">{hoursNote}</p>
</div>
