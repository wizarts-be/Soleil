---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Prices from '../../components/Prices.astro';
import { info, treatments, groups, euro } from '../../data/site';

export function getStaticPaths() {
  return treatments.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const i = treatments.findIndex((x) => x.slug === t.slug);
const prev = treatments[(i - 1 + treatments.length) % treatments.length];
const next = treatments[(i + 1) % treatments.length];
const href = (slug: string) => `/behandelingen/${slug}/`;
const why = t.why?.titles ?? ['Herken je dit?', 'Wat ik doe', 'Wat jij eraan hebt'];
---
<Base title={t.name} description={`${t.name} bij Instituut Soleil in Beervelde: ${t.sub}.`}>
  <div class="wrap" style="padding-top:clamp(24px,3vw,40px)">
    <nav class="tswitch" aria-label="Behandelingen">
      {groups.map((g, gi) => (
        <>
          {gi > 0 && <span class="sep" aria-hidden="true"></span>}
          {g.items.map((x) => <a href={href(x.slug)} aria-current={x.slug === t.slug ? 'page' : undefined}>{x.name}</a>)}
        </>
      ))}
    </nav>
  </div>

  {t.page ? (
    <>
      <header class="wrap thero">
        <div>
          <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li><a href={`/behandelingen/#${t.group?.toLowerCase()}`}>{t.group}</a></li><li aria-current="page">{t.name}</li></ol>
          <h1 class="h1 rv">{t.page.title}</h1>
          <ul class="asks rv" style="--d:1" role="list">{t.page.questions.map((q) => <li>{q}</li>)}</ul>
          <p class="rv" style="--d:2;margin-top:24px;font-weight:500">{t.page.cta}</p>
          <div class="actions rv" style="--d:2;margin-top:24px"><a class="btn" href={info.booking} target="_blank" rel="noopener">Afspraak maken<Icon name="arrow-up-right" /></a></div>
        </div>
        <figure class="ph rv-img"><img src={`/img/${t.img}.webp`} alt={t.alt} fetchpriority="high" /></figure>
      </header>

      <section class="wrap section brand-block" aria-labelledby="merk">
        <figure class="ph rv-img"><img src={`/img/${t.page.story.img}.webp`} alt={t.page.story.alt} loading="lazy" /></figure>
        <div class="rv">
          <p class="label">{t.page.story.label}</p>
          <h2 id="merk" class="h2">{t.page.story.title}</h2>
          {t.page.story.text.map((x) => <p>{x}</p>)}
        </div>
      </section>

      <section class="wrap" aria-labelledby="aanbod">
        <h2 id="aanbod" class="h2 rv" style="margin-bottom:clamp(28px,4vw,48px)">Make-up behandelingen</h2>
        <ul class="services" role="list">
          {t.page.services.map((x, si) => (
            <li class="rv" style={`--d:${si}`}>
              <h3 class="h3">{x.name}</h3>
              {x.tag && <p class="label">{x.tag}</p>}
              <p>{x.text}</p>
              <div class="services-foot"><span>{x.dur}</span><strong>{euro(x.price)}</strong></div>
              <a class="link" href={info.booking} target="_blank" rel="noopener">Boek nu<Icon name="arrow-up-right" /></a>
            </li>
          ))}
        </ul>
      </section>
    </>
  ) : (
    <>
    <header class="wrap thead">
      <figure class="framed rv-img"><img src={`/img/${t.img}.webp`} alt={t.alt} fetchpriority="high" /></figure>
      <div>
        <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li><a href={`/behandelingen/#${t.group?.toLowerCase()}`}>{t.group}</a></li><li aria-current="page">{t.name}</li></ol>
        <p class="label rv">{t.kicker ?? t.sub}</p>
        <h1 class="display rv">{t.title ?? t.name}</h1>
        <p class="lede rv" style="--d:1">{t.intro}</p>
        <div class="actions rv" style="--d:2">
          {t.link ? (
            <a class="btn" href={t.link.href} target="_blank" rel="noopener">{t.link.label}<Icon name="arrow-up-right" /></a>
          ) : (
            <a class="btn" href={info.booking} target="_blank" rel="noopener">Boek hier<Icon name="arrow-up-right" /></a>
          )}
        </div>
      </div>
    </header>

    <section class="wrap tbody">
      <div>
        {t.why && (
          <div class="why">
            <div class="rv"><Icon name="question" /><h3>{why[0]}</h3>{Array.isArray(t.why.problem) ? <ul role="list">{t.why.problem.map((x) => <li>{x}</li>)}</ul> : <p>{t.why.problem}</p>}</div>
            <div class="rv" style="--d:1"><Icon name="hand-heart" /><h3>{why[1]}</h3><p>{t.why.solution}</p></div>
            <div class="rv" style="--d:2"><Icon name="sparkle" /><h3>{why[2]}</h3><p>{t.why.benefit}</p></div>
          </div>
        )}
        {t.parts && (
          <div class="parts" style="margin-top:clamp(48px,6vw,80px)">
            {t.parts.map((p) => (
              <article class="part rv" id={p.id}>
                <figure class="ph"><img src={`/img/${p.img}.webp`} alt={p.alt} loading="lazy" /></figure>
                <div>
                  <h2 class="h3">{p.name}</h2>
                  <p>{p.text}</p>
                  {p.prices.map((g) => <Prices rows={g.rows} title={g.title} />)}
                </div>
              </article>
            ))}
          </div>
        )}
      </div>

      <aside class="panel rv" aria-labelledby="prijzen">
        {t.prices.length > 0 ? (
          <>
            <h2 id="prijzen">Prijzen</h2>
            {t.prices.map((g) => <Prices rows={g.rows} title={g.title} note={g.note} />)}
            {t.note && <p class="price-note">{t.note}</p>}
          </>
        ) : t.parts ? (
          <>
            <h2 id="prijzen">{t.name}</h2>
            <p class="muted">De prijzen staan bij elke behandeling hiernaast.</p>
          </>
        ) : (
          <h2 id="prijzen">{t.name}</h2>
        )}
        {t.extra && (
          <div class="panel-extra">
            <p class="label label--sunset">{t.extra.title}</p>
            {t.extra.text && <p>{t.extra.text}</p>}
            {t.extra.list.length > 0 && <ul role="list">{t.extra.list.map((x) => <li>{x}</li>)}</ul>}
          </div>
        )}
        {t.tip && <p class="price-note">{t.tip}</p>}
        {t.link ? (
          <a class="btn" href={t.link.href} target="_blank" rel="noopener">{t.link.label}<Icon name="arrow-up-right" /></a>
        ) : (
          <a class="btn" href={info.booking} target="_blank" rel="noopener">Afspraak maken<Icon name="arrow-up-right" /></a>
        )}
      </aside>
    </section>
    </>
  )}

  <nav class="wrap section" style="padding-bottom:0" aria-label="Vorige en volgende behandeling">
    <div class="pager">
      <a href={href(prev.slug)}><small><Icon name="arrow-left" />Vorige behandeling</small><strong>{prev.name}</strong></a>
      <a href={href(next.slug)}><small>Volgende behandeling<Icon name="arrow-right" /></small><strong>{next.name}</strong></a>
    </div>
  </nav>
</Base>
