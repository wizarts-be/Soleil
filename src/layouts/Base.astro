---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import { info } from '../data/site';
interface Props { title: string; description: string; image?: string }
const { title, description, image = '/img/zaakvoerder-behandeling.webp' } = Astro.props;
const full = title.includes('Soleil') ? title : `${title} | Instituut Soleil Beervelde`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Review layer (post-its, repo stijndemulder-wiz/postit-review). Remove before go-live.
const postitSrc = import.meta.env.PUBLIC_POSTIT_SRC ?? 'https://wizarts-postits.netlify.app/postits.js';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: info.name,
  url: Astro.site?.toString(),
  telephone: '+32470229202',
  email: info.email,
  image: new URL('/img/zaakvoerder-behandeling.webp', Astro.site).toString(),
  address: { '@type': 'PostalAddress', streetAddress: info.street, postalCode: '9080', addressLocality: 'Beervelde', addressCountry: 'BE' },
  openingHours: ['Mo 09:00-18:00', 'Tu 08:00-18:30', 'Th 08:00-20:00', 'Fr 08:00-18:00', 'Sa 09:00-13:30'],
  sameAs: [info.instagram, info.facebook],
};
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <!-- (c) 2026 Wizarts BV, wizarts.be, wzts-gawfozonsd -->
    <meta name="author" content="Wizarts BV" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbf9f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="nl_BE" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
    <script is:inline defer src={postitSrc} data-postit-laag data-project="soleil" data-vaste-header="[data-header]"></script>
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <Newsletter />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
